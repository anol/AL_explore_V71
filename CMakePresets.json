{
  "$schema": "https://gitlab.kitware.com/cmake/cmake/-/raw/master/Help/manual/presets/schema.json",
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/bin"
      }
    },
    {
      "name": "Unit_test",
      "inherits": "base",
      "displayName": "Unit_test",
      "description": "Unit_test",
      "cacheVariables": {
        "TARGET": "Unit_test",
        "BOARD": "Win11",
        "PLATFORM": "Win11"
      }
    },
    {
      "name": "Hello_AstraLEO_Win11",
      "inherits": "base",
      "displayName": "Hello_AstraLEO_Win11",
      "description": "Hello_AstraLEO_Win11",
      "cacheVariables": {
        "APP": "Hello_AstraLEO",
        "TARGET": "Hello_AstraLEO_Win11",
        "BOARD": "Win11",
        "PLATFORM": "Win11"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "MinGW"
        }
      }
    },
    {
      "name": "Hello_AstraLEO_EM",
      "inherits": "base",
      "displayName": "Hello_AstraLEO_EM",
      "description": "Hello_AstraLEO_EM",
      "cacheVariables": {
        "APP": "Hello_AstraLEO",
        "TARGET": "Hello_AstraLEO_EM",
        "BOARD": "AstraLEO_EM",
        "PLATFORM": "SamV71",
        "GNU_VERSION": "GNU_ANY",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Unit_test",
      "configurePreset": "Unit_test"
    },
    {
      "name": "Hello_AstraLEO_Win11",
      "configurePreset": "Hello_AstraLEO_Win11"
    },
    {
      "name": "Hello_AstraLEO_EM",
      "configurePreset": "Hello_AstraLEO_EM"
    }
  ]
}

