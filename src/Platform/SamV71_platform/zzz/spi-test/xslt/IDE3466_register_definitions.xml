<register_definitions>
    <block tag="calibration_register" base="0x189u" size="1" name="Calibration (CALGEN)" access="read-write"
           brief="Configuration of the calibration charge generation">
        <register count="1">
            <field tag="CALV" pos="9:0" name="Voltage" brief="Internal DAC voltage"/>
            <field tag="CCAL" pos="12-10" name="Charge" brief="Internal charge capacitor"/>
            <field tag="CALBYPASS" pos="13" name="Charge source"
                   brief="Internal (0) or external (1) calibration charge"/>
            <field tag="CALGEN" pos="14" name="Voltage source"
                   brief="Internal (0) or external (1) calibration voltage"/>
        </register>
    </block>
    <block tag="channel_low_gain" base="0x130u" size="4" name="Low-gain channels (CNFG_LG)" access="read-write"
           brief="Low-gain channel config and trigger threshold">
        <register count="4">
            <field tag="CDR_LG" pos="0" name="Channel disable" brief="Disable channel trigger output"/>
            <field tag="THR_LG" pos="10:1" name="Threshold DAC" init="1023" brief="Threshold DAC for the LG channel"/>
            <field tag="TER_LG" pos="11" name="Test enable"
                   brief="Connected channel to the calibration circuit"/>
        </register>
    </block>
    <block tag="channel_high_gain" base="0x134u" size="64" name="High-gain channels (CNFG_HG)" access="read-write"
           brief="High-gain channel config and trigger threshold">
        <register size="2" count="36">
            <field tag="CDR_HG_L" pos="0" name="Channel disable" brief="Disable channel trigger output"/>
            <field tag="THR_HG_L" pos="10:1" name="Threshold DAC" init="1023" brief="Threshold DAC for the LG channel"/>
            <field tag="CDR_HG_H" pos="1+0" name="Channel disable" brief="Disable channel trigger output"/>
            <field tag="THR_HG_H" pos="1+10:1" name="Threshold DAC" init="1023"
                   brief="Threshold DAC for the LG channel"/>
            <field tag="TER_HG" pos="1+11" name="Test enable"
                   brief="Connected channel to the calibration circuit"/>
        </register>
    </block>
    <block tag="trigger_low_gain" base="0x174u" size="1" name="Trigger low gain (TFF-LG)" access="read-only"/>
    <block tag="trigger_high_gain" base="0x175u" size="3" name="Trigger high gain (TFF-HG)" access="read-only"/>
    <block tag="pattern_configuration" base="0x000u" size="252" name="Pattern configuration (CNFG-CL)"
           access="read-write"/>
    <block tag="pattern_hit_counter" base="0x100u" size="36" name="Pattern hit counter (CNT)" access="read-only"/>
    <block tag="counter_enable" base="0x182u" size="3" name="Counter enable (CL-ENABLE)" access="read-write"/>
    <block tag="gain_and_timing" base="0x186u" size="1" name="Gain and timing (GAIN_AND_MCT)" access="read-write"/>
    <block tag="global_configuration" base="0x185u" size="1" name="Global configuration (GLOBAL-CONF)"
           access="read-write" brief="Misc. global settings">
        <register count="1">
            <field tag="LG_PREBI_BOOST" pos="0" name="Pre-bias boost" brief="Enable pre-bias boost"/>
            <field tag="PWDN_LUD_ANA" pos="7" name="Power down A-latch-up"
                   brief="Power down the analogue latch-up detection unit"/>
            <field tag="PWDN_LUD_DIG" pos="8" name="Power down D-latch-up"
                   brief="Power down the digital latch-up detection unit"/>
            <field tag="PWDN_AOB" pos="10" name="Power down output"
                   brief="Power down the analogue output buffer"/>
        </register>
    </block>
    <block tag="parity_registers" base="0x187u" size="15" name="Parity registers (PARITY_REG)" access="read-only"/>
    <block tag="latch_up_detector" base="0x181u" size="1" name="Latch up detector (SELTHR)" access="read-write"/>
</register_definitions>