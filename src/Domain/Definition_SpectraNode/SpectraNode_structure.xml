<?xml-stylesheet type="text/xsl" href="Script/Structure_to_MD.xsl"?>
<structure product_id="SpectraNode" name="SpectraNode_structure_definition" version="1" keywords="SpectraNode"
           interface="SpectraNode_interface">
     <primary key="device">
        <secondary key="serial_number">
            <tertiary>
                <quaternary>
                    <value type="data32" default="0" nature="config" brief="Device serial number."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="reg_addr">
            <tertiary min="0" max="29">
                <quaternary>
                    <value type="data32" default="0x0200'0323" nature="config"
                           brief="IDE3380 ASIC register default (channel 1-16 control register template; see IDE3380_register_decoder for the rest).">
                        <item index="16" default="0x0000'03C3" brief="Channel 17 (analog summing) control register."/>
                        <item index="17" default="0x0001'9494" brief="Channel config register."/>
                        <item index="18" default="0x0000'0028" brief="Channel control register (global)."/>
                        <item index="19" default="0x0000'0009" brief="ADC config register."/>
                        <item index="20" default="0" brief="Cal DAC register."/>
                        <item index="21" default="0x0003'FFED" brief="PD modules register."/>
                        <item index="22" default="0x0000'0008" brief="Cal control register."/>
                        <item index="23" default="0x0003'FFFE" brief="Readout fixed list register."/>
                        <item index="24" default="0x0000'7D61" brief="Readout mode register."/>
                        <item index="25" default="0" brief="Analog mux control register."/>
                        <item index="26" default="0" brief="ADC clock div register."/>
                        <item index="27" default="0" brief="Sysclock control register."/>
                        <item index="28" default="0" brief="Cmd DCAL PU register."/>
                        <item index="29" default="0" brief="Cmd readout PU register."/>
                    </value>
                </quaternary>
            </tertiary>
        </secondary>
    </primary>
    <primary key="MODE">
        <secondary key="active">
            <tertiary>
                <quaternary>
                    <value type="idle|nominal|demo" default="Key_demo" nature="config"
                           brief="Active operating mode at startup."/>
                </quaternary>
            </tertiary>
        </secondary>
    </primary>
    <primary key="CADENCE">
        <secondary key="DEMO">
            <tertiary>
                <quaternary>
                    <value type="seconds" default="2" nature="config" brief="Telemetry cadence in Demo mode."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="NOMINAL">
            <tertiary>
                <quaternary>
                    <value type="seconds" default="2" nature="config" brief="Telemetry cadence in Nominal mode."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="IDLE">
            <tertiary>
                <quaternary>
                    <value type="seconds" default="2" nature="config" brief="Telemetry cadence in Idle mode."/>
                </quaternary>
            </tertiary>
        </secondary>
    </primary>
    <primary key="CHANNEL">
        <secondary key="DEMO">
            <tertiary>
                <quaternary>
                    <value type="channel" range="0,1-18" default="18" nature="config"
                           brief="Active channel in Demo mode, 0=inhibit, 1-16=input, 17=analog summing, 18=digital summing."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="NOMINAL">
            <tertiary>
                <quaternary>
                    <value type="channel" range="0,1-18" default="18" nature="config"
                           brief="Active channel in Nominal mode."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="IDLE">
            <tertiary>
                <quaternary>
                    <value type="channel" range="0,1-18" default="18" nature="config"
                           brief="Active channel in Idle mode."/>
                </quaternary>
            </tertiary>
        </secondary>
    </primary>
    <primary key="format">
        <secondary key="DEMO">
            <tertiary>
                <quaternary>
                    <value type="no_data|legacy_live_view|simple_R6|only_CPS|complex_N42|housekeeping"
                           default="Key_simple_R6" nature="config" brief="Data format in Demo mode."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="IDLE">
            <tertiary>
                <quaternary>
                    <value type="no_data|legacy_live_view|simple_R6|only_CPS|complex_N42|housekeeping"
                           default="Key_simple_R6" nature="config" brief="Data format in Idle mode."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="NOMINAL">
            <tertiary>
                <quaternary>
                    <value type="no_data|legacy_live_view|simple_R6|only_CPS|complex_N42|housekeeping"
                           default="Key_simple_R6" nature="config" brief="Data format in Nominal mode."/>
                </quaternary>
            </tertiary>
        </secondary>
    </primary>
    <primary key="calibration">
        <secondary key="parameter">
            <tertiary key="a">
                <quaternary>
                    <value type="data32" default="100000" nature="config" brief="Calibration parameter A."/>
                </quaternary>
            </tertiary>
            <tertiary key="b">
                <quaternary>
                    <value type="data32" default="10000" nature="config" brief="Calibration parameter B."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="BIAS">
            <tertiary>
                <quaternary>
                    <value type="data32" default="0" nature="config" brief="Bias voltage at 25 degC reference."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="adc">
            <tertiary key="V35">
                <quaternary>
                    <value type="mV" default="-35000" nature="config" brief="ADC calibration setpoint at -35V."/>
                </quaternary>
            </tertiary>
            <tertiary key="V40">
                <quaternary>
                    <value type="mV" default="-40000" nature="config" brief="ADC calibration setpoint at -40V."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="dac">
            <tertiary key="V35">
                <quaternary>
                    <value type="mV" default="-35000" nature="config" brief="DAC calibration setpoint at -35V."/>
                </quaternary>
            </tertiary>
            <tertiary key="V40">
                <quaternary>
                    <value type="mV" default="-40000" nature="config" brief="DAC calibration setpoint at -40V."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="integration_time">
            <tertiary>
                <quaternary>
                    <value type="number" default="100" nature="config" brief="Calibration pulse integration time."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="start_threshold">
            <tertiary>
                <quaternary>
                    <value type="number" default="100" nature="config" brief="Calibration start threshold."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="stop_count">
            <tertiary>
                <quaternary>
                    <value type="number" default="100" nature="config" brief="Calibration stop count."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="readout_count">
            <tertiary>
                <quaternary>
                    <value type="number" default="100000" nature="config" brief="Calibration readout count."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="pedestal">
            <tertiary min="1" max="16">
                <quaternary>
                    <value type="data32" default="50" nature="config" brief="Per-channel pedestal offset."/>
                </quaternary>
            </tertiary>
        </secondary>
        <secondary key="gain">
            <tertiary min="1" max="16">
                <quaternary>
                    <value type="data32" default="1" nature="config" brief="Per-channel gain factor."/>
                </quaternary>
            </tertiary>
        </secondary>
    </primary>
</structure>
